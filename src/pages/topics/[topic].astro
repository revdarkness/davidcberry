---
import Base from '../../layouts/Base.astro';
import PostCard from '../../components/PostCard.astro';
import { getPublished } from '../../lib/posts';
import { TOPICS } from '../../consts';

export async function getStaticPaths() {
  const posts = await getPublished();
  return (Object.keys(TOPICS) as (keyof typeof TOPICS)[]).map((topic) => ({
    params: { topic },
    props: { posts: posts.filter((p) => p.data.topic === topic) },
  }));
}

const { topic } = Astro.params;
const { posts } = Astro.props;
const meta = TOPICS[topic as keyof typeof TOPICS];
---

<Base title={meta.label} description={meta.blurb}>
  <section class="block">
    <div class="wrap">
      <p class="sec-label">Topic</p>
      <h1 class="sec-h">{meta.label}</h1>
      <p class="sec-sub">{meta.blurb}</p>

      {
        posts.length === 0 ? (
          <p class="sec-sub">Nothing here yet.</p>
        ) : (
          <div class="steps">
            {posts.map((post) => (
              <PostCard post={post} />
            ))}
          </div>
        )
      }

      <p style="margin-top:34px"><a href="/writing/">All writing</a></p>
    </div>
  </section>
</Base>
