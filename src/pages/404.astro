---
import Base from '../layouts/Base.astro';
---

<Base title="Not found" description="That page does not exist.">
  <section class="block">
    <div class="wrap">
      <p class="sec-label">404</p>
      <h1 class="sec-h">That page does not exist.</h1>
      <p class="sec-sub">
        It may have moved, or it may never have been here. The writing index is the best place
        to pick back up.
      </p>
      <p style="margin-top:26px">
        <a href="/writing/" class="btn btn-primary">All writing</a>
      </p>
    </div>
  </section>
</Base>
